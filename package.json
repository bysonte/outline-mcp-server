{
  "name": "getoutline-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Outline document management",
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "bin": {
    "getoutline-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "outline",
    "documents",
    "knowledge-base"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HelicopterHelicopter/outline-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/HelicopterHelicopter/outline-mcp-server/issues"
  },
  "homepage": "https://github.com/HelicopterHelicopter/outline-mcp-server#readme",
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "axios": "1.18.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.6",
    "@types/node": "25.9.3",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
