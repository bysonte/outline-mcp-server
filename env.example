# Outline MCP Server Configuration
# Copy this file to .env and fill in your values

# Your Outline instance URL (e.g., https://app.getoutline.com)
OUTLINE_BASE_URL=https://app.getoutline.com

# Your Outline API token
# Get this from Settings -> API Tokens in your Outline instance
OUTLINE_API_KEY=your-api-token-here

# Set true to hide write tools: create, update and delete document
OUTLINE_READ_ONLY=false

# MCP transport. stdio is the default for local MCP clients; http enables Streamable HTTP.
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp

# Outline HTTP client hardening
# OUTLINE_HTTP_TIMEOUT_MS=10000
OUTLINE_MAX_RETRIES=2
OUTLINE_RETRY_BASE_DELAY_MS=100
